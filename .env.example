DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL is required for every environment. Set DB_PASSWORD explicitly,
# even when the local PostgreSQL role uses passwordless local authentication.
DB_NAME=mod_nsukka
DB_USER=mod_app
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Tests use a separate PostgreSQL role and database. The role needs CREATEDB,
# or pre-provision TEST_DB_NAME and grant it schema/database permissions.
TEST_DB_NAME=test_mod_nsukka
TEST_DB_USER=mod_test
TEST_DB_PASSWORD=replace-me
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_SSLMODE=prefer
TEST_DB_MAINTENANCE_DATABASE=postgres

PUBLIC_BASE_URL=https://your-public-domain.example

# SMTP delivery for Chairman account activation (automatically attempted when
# a superuser issues or reissues an activation link).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
CHAIRMAN_ACTIVATION_EMAIL_ENABLED=False

# Membership registration notifications use the Gmail API outbox.
GMAIL_API_ENABLED=False
GMAIL_API_SENDER=deglobeal@gmail.com
GMAIL_OAUTH_CREDENTIALS_FILE=~/.config/mod-nsukka/credentials.json
GMAIL_OAUTH_TOKEN_FILE=~/.config/mod-nsukka/token.json
# Use the JSON secret variables below on serverless hosts with no persistent files.
GMAIL_OAUTH_CREDENTIALS_JSON=
GMAIL_OAUTH_TOKEN_JSON=

# Sendar SMS Gateway
SENDAR_API_KEY=
SENDAR_API_BASE_URL=https://api.sendar.io
SENDAR_SENDER_ID=
SENDAR_ROUTE=transactional
SENDAR_TIMEOUT_SECONDS=15
SENDAR_ENVIRONMENT=sandbox
SENDAR_ENABLED=False
